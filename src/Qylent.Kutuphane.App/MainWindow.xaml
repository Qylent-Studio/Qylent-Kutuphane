<Window x:Class="Qylent.Kutuphane.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Qylent.Kutuphane.App.Ui"
        Title="Qylent Kütüphane" Width="1280" Height="820" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources><ui:PageEqualsConverter x:Key="PageEquals" /></Window.Resources>
    <Grid Background="{DynamicResource Paper}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0">
            <Grid Margin="20,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel><TextBlock FontFamily="Bahnschrift SemiBold" FontWeight="SemiBold" FontSize="22" Text="QYLENT" /><TextBlock Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono" FontSize="12" Text="KÜTÜPHANE / YEREL" Margin="0,3,0,0" /></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Button Style="{StaticResource NavButton}" Tag="{Binding IsCirculationPage}" Command="{Binding NavigateCommand}" CommandParameter="Dolaşım" AutomationProperties.Name="Ödünç ve iade"><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3,3 H15 V7 H13 V5 H5 V13 H9 V15 H3 Z M11,9 H17 V15 H11 Z" /><TextBlock Text="Ödünç / İade" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding IsCatalogPage}" Command="{Binding NavigateCommand}" CommandParameter="Katalog" AutomationProperties.Name="Katalog"><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M2,3 H8 C10,3 11,4 11,6 V16 C10,15 9,15 8,15 H2 Z M12,6 C12,4 13,3 15,3 H20 V15 H14 C13,15 12,15 12,16 Z" /><TextBlock Text="Katalog" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding IsMembersPage}" Command="{Binding NavigateCommand}" CommandParameter="Üyeler" AutomationProperties.Name="Üyeler"><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M9,3 A3,3 0 1 1 8.9,3 M3,16 C3,12 5,10 9,10 C13,10 15,12 15,16 Z M16,5 A2,2 0 1 1 15.9,5 M15,10 C18,10 20,12 20,15 H16" /><TextBlock Text="Üyeler" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding IsReservationsPage}" Command="{Binding NavigateCommand}" CommandParameter="Ayırtmalar" AutomationProperties.Name="Ayırtmalar"><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M5,2 H17 V20 L11,16 L5,20 Z" /><TextBlock Text="Ayırtmalar" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding IsOverduePage}" Command="{Binding NavigateCommand}" CommandParameter="Gecikenler" AutomationProperties.Name="Gecikenler"><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M11,2 A9,9 0 1 1 2,11 A9,9 0 0 1 11,2 M10,6 H12 V12 H16 V14 H10 Z" /><TextBlock Text="Gecikenler" /></StackPanel></Button>
                    <Separator Margin="0,14" Background="{DynamicResource Rule}" />
                    <Button Style="{StaticResource NavButton}" Tag="{Binding IsAdminPage}" Click="AdminButton_Click" AutomationProperties.Name="Yönetim"><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M9,2 H15 L16,5 L19,6 V12 L16,13 L15,16 H9 L8,13 L5,12 V6 L8,5 Z M12,7 A3,3 0 1 1 11.9,7" /><TextBlock Text="Yönetim" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Grid.Row="2" Foreground="{DynamicResource Muted}" FontSize="12" Text="Çevrimdışı · Tek bilgisayar" />
            </Grid>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="34,28,34,34">
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Dolaşım}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Ödünç ve iade" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Hızlı işlem" /><TextBlock Style="{StaticResource Label}" Text="Üye numarası" /><TextBox Text="{Binding MemberNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Üye numarası" /><TextBlock Style="{StaticResource Label}" Text="Barkod / demirbaş kodu" Margin="0,14,0,5" /><TextBox x:Name="BarcodeBox" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Barkod veya demirbaş kodu" KeyDown="BarcodeBox_KeyDown" /><UniformGrid Columns="2" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckoutCommand}" Content="Ödünç ver" Margin="0,0,6,0" /><Button Command="{Binding ReturnCommand}" Content="İade al" Margin="6,0,0,0" /></UniformGrid><TextBlock Foreground="{DynamicResource Muted}" Margin="0,14,0,0" Text="Barkod okuyucu klavye gibi çalışır. İade için üye numarası gerekmez." /></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><DockPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource SectionTitle}" Text="Aktif ödünçler" DockPanel.Dock="Left" /><Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Content="Yenile" MinWidth="74" Padding="10,4" /></DockPanel><DataGrid ItemsSource="{Binding ActiveLoans}" SelectedItem="{Binding SelectedLoan}" Height="430"><DataGrid.Columns><DataGridTextColumn Header="Üye" Binding="{Binding MemberName}" Width="*" /><DataGridTextColumn Header="Kitap" Binding="{Binding BookTitle}" Width="1.3*" /><DataGridTextColumn Header="Teslim" Binding="{Binding DueAtUtc, StringFormat={}{0:dd.MM.yyyy}}" Width="105" /></DataGrid.Columns></DataGrid><Button Command="{Binding RenewCommand}" Content="Seçili ödüncü uzat" HorizontalAlignment="Right" Margin="0,12,0,0" /></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Katalog}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Katalog" /><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCatalogCommand}" Content="Ara" Margin="12,0,0,0" /><TextBox Text="{Binding CatalogQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kitap ara" ToolTip="Kitap adı, yazar, ISBN veya barkod" /></DockPanel>
                        <DataGrid ItemsSource="{Binding CatalogResults}" SelectedItem="{Binding SelectedBook}" Height="480"><DataGrid.Columns><DataGridTextColumn Header="Kitap" Binding="{Binding Title}" Width="1.5*" /><DataGridTextColumn Header="Yazar" Binding="{Binding Authors}" Width="*" /><DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="130" /><DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="120" /><DataGridTextColumn Header="Raf" Binding="{Binding ShelfLocation}" Width="90" /><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100" /></DataGrid.Columns></DataGrid>
                        <DockPanel Margin="0,12,0,0"><TextBlock Foreground="{DynamicResource Muted}" Text="Ayırtmak için üye numarasını hızlı işlem ekranında girin." /><Button DockPanel.Dock="Right" Command="{Binding ReserveCommand}" Content="Seçili kitabı ayırt" /></DockPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Üyeler}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Üyeler" /><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchMembersCommand}" Content="Ara" Margin="12,0,0,0" /><TextBox Text="{Binding MemberQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Üye ara" ToolTip="Üye numarası veya ad" /></DockPanel>
                        <DataGrid ItemsSource="{Binding MemberResults}" SelectedItem="{Binding SelectedMember}" Height="500"><DataGrid.Columns><DataGridTextColumn Header="Üye no" Binding="{Binding MemberNumber}" Width="140" /><DataGridTextColumn Header="Ad soyad" Binding="{Binding FullName}" Width="*" /><DataGridTextColumn Header="Tür" Binding="{Binding MemberType}" Width="150" /><DataGridTextColumn Header="Sınıf / birim" Binding="{Binding ClassOrUnit}" Width="160" /><DataGridCheckBoxColumn Header="Engelli" Binding="{Binding IsBlocked}" Width="90" /></DataGrid.Columns></DataGrid>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Ayırtmalar}"><TextBlock Style="{StaticResource PageTitle}" Text="Ayırtmalar" /><DataGrid ItemsSource="{Binding Reservations}" Height="520"><DataGrid.Columns><DataGridTextColumn Header="Sıra" Binding="{Binding QueuePosition}" Width="70" /><DataGridTextColumn Header="Üye no" Binding="{Binding MemberNumber}" Width="120" /><DataGridTextColumn Header="Üye" Binding="{Binding MemberName}" Width="*" /><DataGridTextColumn Header="Kitap" Binding="{Binding BookTitle}" Width="1.4*" /><DataGridTextColumn Header="Tarih" Binding="{Binding RequestedAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" /><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100" /></DataGrid.Columns></DataGrid></StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Gecikenler}"><TextBlock Style="{StaticResource PageTitle}" Text="Gecikenler" /><DataGrid ItemsSource="{Binding OverdueLoans}" SelectedItem="{Binding SelectedLoan}" Height="520"><DataGrid.Columns><DataGridTextColumn Header="Üye no" Binding="{Binding MemberNumber}" Width="120" /><DataGridTextColumn Header="Üye" Binding="{Binding MemberName}" Width="*" /><DataGridTextColumn Header="Kitap" Binding="{Binding BookTitle}" Width="1.3*" /><DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="120" /><DataGridTextColumn Header="Teslim" Binding="{Binding DueAtUtc, StringFormat={}{0:dd.MM.yyyy}}" Width="110" /></DataGrid.Columns></DataGrid></StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Admin}">
                        <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Click="LockAdmin_Click" Content="Oturumu kilitle" /><TextBlock Style="{StaticResource PageTitle}" Text="Yönetim" /></DockPanel>
                        <TabControl Background="Transparent" BorderBrush="{DynamicResource Rule}">
                            <TabItem Header="Kitaplar">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions><RowDefinition Height="220" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Panel}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Kitap bilgileri" />
                                            <TextBlock Style="{StaticResource Label}" Text="Kitap adı" /><TextBox Text="{Binding NewBookTitle}" />
                                            <TextBlock Style="{StaticResource Label}" Text="Yazarlar" Margin="0,10,0,5" /><TextBox Text="{Binding NewBookAuthors}" />
                                            <TextBlock Style="{StaticResource Label}" Text="ISBN" Margin="0,10,0,5" /><TextBox Text="{Binding NewBookIsbn}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="Kategori" /><TextBox Text="{Binding NewBookCategory}" />
                                            <TextBlock Style="{StaticResource Label}" Text="Barkod / demirbaş (zorunlu)" Margin="0,10,0,5" /><TextBox Text="{Binding NewBookBarcode}" AutomationProperties.Name="Zorunlu barkod veya demirbaş kodu" />
                                            <TextBlock Style="{StaticResource Label}" Text="Raf" Margin="0,10,0,5" /><TextBox Text="{Binding NewBookShelf}" />
                                            <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Left" Command="{Binding LoadSelectedBookCommand}" Content="Seçileni yükle" /><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddBookCommand}" Content="Yeni kitap ve ilk kopyayı ekle" /></DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Panel}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchAdminBooksCommand}" Content="Ara" Margin="10,0,0,0" /><TextBox Text="{Binding AdminBookQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Kitap adı, yazar, ISBN veya barkod" AutomationProperties.Name="Yönetimde kitap ara" /></DockPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding AdminBookResults}" SelectedItem="{Binding SelectedAdminBook}">
                                                <DataGrid.Columns><DataGridTextColumn Header="Kitap" Binding="{Binding Title}" Width="1.4*" /><DataGridTextColumn Header="Yazar" Binding="{Binding Authors}" Width="*" /><DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="120" /><DataGridTextColumn Header="Raf" Binding="{Binding ShelfLocation}" Width="90" /><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100" /><DataGridCheckBoxColumn Header="Başlık arşivli" Binding="{Binding IsTitleArchived}" Width="105" /></DataGrid.Columns>
                                            </DataGrid>
                                            <UniformGrid Grid.Row="2" Columns="3" HorizontalAlignment="Right" Width="390" Margin="0,10,0,0"><Button Command="{Binding UpdateSelectedBookCommand}" Content="Güncelle" Margin="0,0,4,0" /><Button Command="{Binding ArchiveSelectedBookCommand}" Content="Kitabı arşivle" Margin="4,0" /><Button Command="{Binding DeleteSelectedBookCommand}" Content="Kalıcı sil" Margin="4,0,0,0" /></UniformGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Üyeler">
                                <Grid Margin="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Panel}"><ScrollViewer><StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Üye bilgileri" />
                                        <UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="Üye numarası" /><TextBox Text="{Binding NewMemberNumber}" /></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Ad soyad" /><TextBox Text="{Binding NewMemberName}" /></StackPanel></UniformGrid>
                                        <UniformGrid Columns="2" Margin="0,10,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="Üye türü" /><TextBox Text="{Binding NewMemberType}" /></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="{Binding MemberClassOrUnitLabel}" /><TextBox Text="{Binding NewMemberUnit}" /></StackPanel></UniformGrid>
                                        <TextBlock Style="{StaticResource Label}" Text="Telefon" Margin="0,10,0,5" /><TextBox Text="{Binding NewMemberPhone}" />
                                        <TextBlock Style="{StaticResource Label}" Text="E-posta" Margin="0,10,0,5" /><TextBox Text="{Binding NewMemberEmail}" />
                                        <TextBlock Style="{StaticResource Label}" Text="Adres" Margin="0,10,0,5" /><TextBox Text="{Binding NewMemberAddress}" />
                                        <ItemsControl ItemsSource="{Binding EditableMemberFields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,10,0,0"><DockPanel Margin="0,0,0,5"><TextBlock Style="{StaticResource Label}" Text="{Binding Label}" /><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono" FontSize="11" Text="{Binding FieldType}" /></DockPanel><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <DockPanel Margin="0,14,0,0"><Button DockPanel.Dock="Left" Command="{Binding LoadSelectedMemberCommand}" Content="Seçileni yükle" /><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddMemberCommand}" Content="Yeni üye ekle" /></DockPanel>
                                        <UniformGrid Columns="3" Margin="0,10,0,0"><Button Command="{Binding UpdateSelectedMemberCommand}" Content="Güncelle" Margin="0,0,4,0" /><Button Command="{Binding ArchiveSelectedMemberCommand}" Content="Arşivle" Margin="4,0" /><Button Command="{Binding DeleteSelectedMemberCommand}" Content="Kalıcı sil" Margin="4,0,0,0" /></UniformGrid>
                                    </StackPanel></ScrollViewer></Border>
                                    <Border Grid.Column="2" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchAdminMembersCommand}" Content="Ara" Margin="10,0,0,0" /><TextBox Text="{Binding AdminMemberQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Yönetimde üye ara" /></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding AdminMemberResults}" SelectedItem="{Binding SelectedAdminMember}"><DataGrid.Columns><DataGridTextColumn Header="No" Binding="{Binding MemberNumber}" Width="90" /><DataGridTextColumn Header="Ad soyad" Binding="{Binding FullName}" Width="*" /><DataGridTextColumn Header="Tür" Binding="{Binding MemberType}" Width="90" /><DataGridCheckBoxColumn Header="Arşivli" Binding="{Binding IsArchived}" Width="70" /></DataGrid.Columns></DataGrid></Grid></Border>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Kurallar"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Ödünç kuralı" /><UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Kural adı" /><TextBox Text="{Binding NewRuleName}" /></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Üye türü (isteğe bağlı)" /><TextBox Text="{Binding NewRuleMemberType}" /></StackPanel></UniformGrid><TextBlock Style="{StaticResource Label}" Text="Kitap kategorisi (isteğe bağlı)" Margin="0,12,0,5" /><TextBox Text="{Binding NewRuleCategory}" /><UniformGrid Columns="3" Margin="0,12,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="Gün" /><TextBox Text="{Binding NewRuleDays}" /></StackPanel><StackPanel Margin="6,0"><TextBlock Style="{StaticResource Label}" Text="Kitap sınırı" /><TextBox Text="{Binding NewRuleMaxLoans}" /></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Uzatma" /><TextBox Text="{Binding NewRuleMaxRenewals}" /></StackPanel></UniformGrid><DockPanel Margin="0,16,0,0"><Button DockPanel.Dock="Left" Command="{Binding LoadSelectedRuleCommand}" Content="Seçileni yükle" /><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddRuleCommand}" Content="Yeni kural ekle" /></DockPanel><UniformGrid Columns="3" Margin="0,10,0,0"><Button Command="{Binding UpdateSelectedRuleCommand}" Content="Güncelle" Margin="0,0,4,0" /><Button Command="{Binding ToggleSelectedRuleCommand}" Content="Etkin / devre dışı" Margin="4,0" /><Button Command="{Binding DeleteSelectedRuleCommand}" Content="Sil" Margin="4,0,0,0" /></UniformGrid></StackPanel></Border><DataGrid Grid.Column="2" ItemsSource="{Binding LoanRules}" SelectedItem="{Binding SelectedLoanRule}"><DataGrid.Columns><DataGridTextColumn Header="Kural" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Gün" Binding="{Binding LoanDays}" Width="55" /><DataGridTextColumn Header="Sınır" Binding="{Binding MaxActiveLoans}" Width="55" /><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="60" /></DataGrid.Columns></DataGrid></Grid></TabItem>
                            <TabItem Header="Görevliler ve alanlar"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Görevli" /><TextBlock Style="{StaticResource Label}" Text="Görevli adı" /><TextBox Text="{Binding NewOperatorName}" /><TextBlock Style="{StaticResource Label}" Text="Yeni PIN (boşsa değişmez)" Margin="0,12,0,5" /><TextBox Text="{Binding NewOperatorPin}" /><DockPanel Margin="0,14,0,0"><Button DockPanel.Dock="Left" Command="{Binding LoadSelectedOperatorCommand}" Content="Seçileni yükle" /><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddOperatorCommand}" Content="Yeni görevli ekle" /></DockPanel><DataGrid ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}" Height="150" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Görevli" Binding="{Binding Name}" Width="*" /><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="70" /></DataGrid.Columns></DataGrid><UniformGrid Columns="3" Margin="0,10,0,0"><Button Command="{Binding UpdateSelectedOperatorCommand}" Content="Güncelle" Margin="0,0,4,0" /><Button Command="{Binding ToggleSelectedOperatorCommand}" Content="Etkin / devre dışı" Margin="4,0" /><Button Command="{Binding DeleteSelectedOperatorCommand}" Content="Sil" Margin="4,0,0,0" /></UniformGrid></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Üye alanı" /><TextBlock Style="{StaticResource Label}" Text="Alan adı" /><TextBox Text="{Binding NewFieldName}" /><TextBlock Style="{StaticResource Label}" Text="Alan türü" Margin="0,10,0,5" /><ComboBox SelectedIndex="{Binding NewFieldTypeIndex}"><ComboBoxItem Content="Metin" /><ComboBoxItem Content="Sayı" /><ComboBoxItem Content="Tarih" /><ComboBoxItem Content="Seçim" /><ComboBoxItem Content="Evet / hayır" /></ComboBox><WrapPanel Margin="0,10,0,0"><CheckBox Content="Zorunlu" IsChecked="{Binding NewFieldRequired}" Margin="0,0,16,0" /><CheckBox Content="Hassas alan — şifrele" IsChecked="{Binding NewFieldSensitive}" /></WrapPanel><TextBox Text="{Binding NewFieldChoices}" ToolTip="Seçim türünde seçenekleri virgülle ayırın" Margin="0,10,0,0" /><DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Left" Command="{Binding LoadSelectedMemberFieldCommand}" Content="Seçileni yükle" /><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddMemberFieldCommand}" Content="Yeni alan ekle" /></DockPanel><DataGrid ItemsSource="{Binding MemberFields}" SelectedItem="{Binding SelectedMemberField}" Height="115" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Alan" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Tür" Binding="{Binding FieldType}" Width="75" /><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsEnabled}" Width="55" /></DataGrid.Columns></DataGrid><UniformGrid Columns="3" Margin="0,10,0,0"><Button Command="{Binding UpdateSelectedMemberFieldCommand}" Content="Güncelle" Margin="0,0,4,0" /><Button Command="{Binding ToggleSelectedMemberFieldCommand}" Content="Etkin / devre dışı" Margin="4,0" /><Button Command="{Binding DeleteSelectedMemberFieldCommand}" Content="Sil" Margin="4,0,0,0" /></UniformGrid></StackPanel></Border></Grid></TabItem>
                            <TabItem Header="İşlem günlüğü"><DataGrid ItemsSource="{Binding AuditEntries}" Margin="12" Height="430"><DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding OccurredAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145" /><DataGridTextColumn Header="İşlem" Binding="{Binding Activity}" Width="140" /><DataGridTextColumn Header="Görevli" Binding="{Binding Actor}" Width="130" /><DataGridTextColumn Header="Kayıt" Binding="{Binding Entity}" Width="130" /><DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*" /></DataGrid.Columns></DataGrid></TabItem>
                            <TabItem Header="Raporlar"><ScrollViewer><Border Style="{StaticResource Panel}" Margin="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Excel dönem raporu" /><TextBlock Style="{StaticResource Label}" Text="Dönem" /><ComboBox SelectedIndex="{Binding ReportPeriodIndex}"><ComboBoxItem Content="Günlük" /><ComboBoxItem Content="Haftalık (Pazartesi–Pazar)" /><ComboBoxItem Content="Aylık" /><ComboBoxItem Content="Özel tarih aralığı" /></ComboBox><UniformGrid Columns="2" Margin="0,12,0,0"><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Başlangıç" /><DatePicker SelectedDate="{Binding ReportStart}" /></StackPanel><StackPanel Margin="10,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Bitiş" /><DatePicker SelectedDate="{Binding ReportEnd}" /></StackPanel></UniformGrid><TextBlock Style="{StaticResource Label}" Text="İşlemler sütunları" Margin="0,16,0,5" /><WrapPanel><CheckBox IsChecked="{Binding IncludeReportDate}" Content="Tarih" Margin="0,0,14,8" /><CheckBox IsChecked="{Binding IncludeReportActivity}" Content="İşlem" Margin="0,0,14,8" /><CheckBox IsChecked="{Binding IncludeReportOperator}" Content="Görevli" Margin="0,0,14,8" /><CheckBox IsChecked="{Binding IncludeReportEntity}" Content="Kayıt türü" Margin="0,0,14,8" /><CheckBox IsChecked="{Binding IncludeReportDescription}" Content="Açıklama" Margin="0,0,14,8" /></WrapPanel><CheckBox IsChecked="{Binding IncludeOverdueSheet}" Content="Gecikenler sayfasını ekle" Margin="0,8,0,8" /><CheckBox IsChecked="{Binding IncludeReservationsSheet}" Content="Ayırtmalar sayfasını ekle" /><Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportReportCommand}" Content="Excel raporu oluştur" HorizontalAlignment="Right" Margin="0,20,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource SectionTitle}" Text="Rapor şablonları" /><TextBlock Style="{StaticResource Label}" Text="Şablon adı" /><TextBox Text="{Binding ReportPresetName}" /><ComboBox ItemsSource="{Binding ReportPresets}" SelectedItem="{Binding SelectedReportPreset}" DisplayMemberPath="Name" Margin="0,12,0,0" /><UniformGrid Columns="3" Margin="0,12,0,0"><Button Command="{Binding SaveReportPresetCommand}" Content="Kaydet" Margin="0,0,4,0" /><Button Command="{Binding ApplyReportPresetCommand}" Content="Uygula" Margin="4,0" /><Button Command="{Binding DeleteReportPresetCommand}" Content="Sil" Margin="4,0,0,0" /></UniformGrid></StackPanel></Grid></Border></ScrollViewer></TabItem>
                            <TabItem Header="Ayarlar"><ScrollViewer><Border Style="{StaticResource Panel}" Margin="12"><StackPanel MaxWidth="720" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SectionTitle}" Text="Kütüphane ayarları" /><UniformGrid Columns="2"><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Kütüphane adı" /><TextBox Text="{Binding SettingsLibraryName}" /></StackPanel><StackPanel Margin="10,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Logo dosyası (isteğe bağlı)" /><TextBox Text="{Binding SettingsLogoPath}" /></StackPanel></UniformGrid><UniformGrid Columns="2" Margin="0,14,0,0"><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Kütüphane türü" /><ComboBox SelectedIndex="{Binding SettingsLibraryTypeIndex}"><ComboBoxItem Content="Okul" /><ComboBoxItem Content="Halk" /><ComboBoxItem Content="Özel kurum" /><ComboBoxItem Content="Genel" /></ComboBox></StackPanel><StackPanel Margin="10,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Görevli modu" /><ComboBox SelectedIndex="{Binding SettingsOperatorModeIndex}"><ComboBoxItem Content="Ortak görevli" /><ComboBoxItem Content="İsim seçimi" /><ComboBoxItem Content="PIN" /></ComboBox></StackPanel></UniformGrid><TextBlock Style="{StaticResource Label}" Text="Varsayılan ödünç sınırları" Margin="0,16,0,5" /><UniformGrid Columns="3"><StackPanel Margin="0,0,6,0"><TextBlock Foreground="{DynamicResource Muted}" Text="Gün" /><TextBox Text="{Binding SettingsLoanDays}" /></StackPanel><StackPanel Margin="6,0"><TextBlock Foreground="{DynamicResource Muted}" Text="Kitap" /><TextBox Text="{Binding SettingsMaxLoans}" /></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Foreground="{DynamicResource Muted}" Text="Uzatma" /><TextBox Text="{Binding SettingsMaxRenewals}" /></StackPanel></UniformGrid><TextBlock Style="{StaticResource Label}" Text="Yedekleme klasörü" Margin="0,16,0,5" /><TextBox Text="{Binding SettingsBackupDirectory}" /><Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Content="Ayarları kaydet" HorizontalAlignment="Right" Margin="0,20,0,0" /></StackPanel></Border></ScrollViewer></TabItem>
                            <TabItem Header="Yedekleme"><Border Style="{StaticResource Panel}" Margin="12"><StackPanel MaxWidth="620" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SectionTitle}" Text="Şifreli yedek" /><TextBlock Foreground="{DynamicResource Muted}" Text="Parola en az 10 karakter olmalıdır. Geri yüklemeden önce mevcut verinin güvenlik yedeği otomatik alınır." Margin="0,0,0,14" /><TextBlock Style="{StaticResource Label}" Text="Yedek parolası" /><PasswordBox x:Name="BackupPasswordBox" AutomationProperties.Name="Yedek parolası" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Click="RestoreBackup_Click" Content="Yedekten geri yükle" Margin="0,0,10,0" /><Button Style="{StaticResource PrimaryButton}" Click="CreateBackup_Click" Content="Yedek oluştur" /></StackPanel></StackPanel></Border></TabItem>
                            <TabItem Header="Görünüm"><Border Style="{StaticResource Panel}" Margin="12"><StackPanel MaxWidth="620" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SectionTitle}" Text="Tema ve kurum görünümü" /><TextBlock Style="{StaticResource Label}" Text="Tema" /><ComboBox SelectedIndex="{Binding SettingsThemeIndex}"><ComboBoxItem Content="Açık" /><ComboBoxItem Content="Koyu" /><ComboBoxItem Content="Windows sistem ayarını izle" /></ComboBox><TextBlock Style="{StaticResource Label}" Text="Seçili kurum profilinin üye alanları" Margin="0,18,0,5" /><Border Background="{DynamicResource Header}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="5" Padding="12"><StackPanel><TextBlock Text="{Binding SettingsProfileDescription}" /><TextBlock Foreground="{DynamicResource Muted}" Margin="0,6,0,0" Text="Kurum türü değiştiğinde mevcut veriler korunur; yeni hazır alanlar eklenir ve eski profile ait alanlar gizlenir." /></StackPanel></Border><Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Content="Görünümü kaydet ve uygula" HorizontalAlignment="Right" Margin="0,20,0,0" /></StackPanel></Border></TabItem>
                        </TabControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="20,12"><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" Text="{Binding ActiveOperatorName, StringFormat=Görevli: {0}}" /><TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Error}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel></Border>
        </Grid>
