<Window x:Class="Qylent.Kutuphane.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Qylent.Kutuphane.App.Ui"
        Title="Qylent Kütüphane" Width="1280" Height="820" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources><ui:PageEqualsConverter x:Key="PageEquals" /></Window.Resources>
    <Grid Background="{StaticResource Paper}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
            <Grid Margin="20,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel><TextBlock FontFamily="Bahnschrift SemiBold" FontWeight="SemiBold" FontSize="22" Text="QYLENT" /><TextBlock Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono" FontSize="12" Text="KÜTÜPHANE / YEREL" Margin="0,3,0,0" /></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dolaşım" Content="Ödünç / İade" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Katalog" Content="Katalog" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Üyeler" Content="Üyeler" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Ayırtmalar" Content="Ayırtmalar" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Gecikenler" Content="Gecikenler" />
                    <Separator Margin="0,14" Background="{StaticResource Rule}" />
                    <Button Style="{StaticResource NavButton}" Click="AdminButton_Click" Content="Admin" />
                </StackPanel>
                <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="12" Text="Çevrimdışı · Tek bilgisayar" />
            </Grid>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="34,28,34,34">
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Dolaşım}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Ödünç ve iade" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Hızlı işlem" /><TextBlock Style="{StaticResource Label}" Text="Üye numarası" /><TextBox Text="{Binding MemberNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Üye numarası" /><TextBlock Style="{StaticResource Label}" Text="Barkod / demirbaş kodu" Margin="0,14,0,5" /><TextBox x:Name="BarcodeBox" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Barkod veya demirbaş kodu" KeyDown="BarcodeBox_KeyDown" /><UniformGrid Columns="2" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckoutCommand}" Content="Ödünç ver" Margin="0,0,6,0" /><Button Command="{Binding ReturnCommand}" Content="İade al" Margin="6,0,0,0" /></UniformGrid><TextBlock Foreground="{StaticResource Muted}" Margin="0,14,0,0" Text="Barkod okuyucu klavye gibi çalışır. İade için üye numarası gerekmez." /></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><DockPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource SectionTitle}" Text="Aktif ödünçler" DockPanel.Dock="Left" /><Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Content="Yenile" MinWidth="74" Padding="10,4" /></DockPanel><DataGrid ItemsSource="{Binding ActiveLoans}" SelectedItem="{Binding SelectedLoan}" Height="430"><DataGrid.Columns><DataGridTextColumn Header="Üye" Binding="{Binding MemberName}" Width="*" /><DataGridTextColumn Header="Kitap" Binding="{Binding BookTitle}" Width="1.3*" /><DataGridTextColumn Header="Teslim" Binding="{Binding DueAtUtc, StringFormat={}{0:dd.MM.yyyy}}" Width="105" /></DataGrid.Columns></DataGrid><Button Command="{Binding RenewCommand}" Content="Seçili ödüncü uzat" HorizontalAlignment="Right" Margin="0,12,0,0" /></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Katalog}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Katalog" /><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCatalogCommand}" Content="Ara" Margin="12,0,0,0" /><TextBox Text="{Binding CatalogQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kitap ara" ToolTip="Kitap adı, yazar, ISBN veya barkod" /></DockPanel>
                        <DataGrid ItemsSource="{Binding CatalogResults}" SelectedItem="{Binding SelectedBook}" Height="480"><DataGrid.Columns><DataGridTextColumn Header="Kitap" Binding="{Binding Title}" Width="1.5*" /><DataGridTextColumn Header="Yazar" Binding="{Binding Authors}" Width="*" /><DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="130" /><DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="120" /><DataGridTextColumn Header="Raf" Binding="{Binding ShelfLocation}" Width="90" /><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100" /></DataGrid.Columns></DataGrid>
                        <DockPanel Margin="0,12,0,0"><TextBlock Foreground="{StaticResource Muted}" Text="Ayırtmak için üye numarasını hızlı işlem ekranında girin." /><Button DockPanel.Dock="Right" Command="{Binding ReserveCommand}" Content="Seçili kitabı ayırt" /></DockPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Üyeler}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Üyeler" /><DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchMembersCommand}" Content="Ara" Margin="12,0,0,0" /><TextBox Text="{Binding MemberQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Üye ara" ToolTip="Üye numarası veya ad" /></DockPanel>
                        <DataGrid ItemsSource="{Binding MemberResults}" SelectedItem="{Binding SelectedMember}" Height="500"><DataGrid.Columns><DataGridTextColumn Header="Üye no" Binding="{Binding MemberNumber}" Width="140" /><DataGridTextColumn Header="Ad soyad" Binding="{Binding FullName}" Width="*" /><DataGridTextColumn Header="Tür" Binding="{Binding MemberType}" Width="150" /><DataGridTextColumn Header="Sınıf / birim" Binding="{Binding ClassOrUnit}" Width="160" /><DataGridCheckBoxColumn Header="Engelli" Binding="{Binding IsBlocked}" Width="90" /></DataGrid.Columns></DataGrid>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Ayırtmalar}"><TextBlock Style="{StaticResource PageTitle}" Text="Ayırtmalar" /><DataGrid ItemsSource="{Binding Reservations}" Height="520"><DataGrid.Columns><DataGridTextColumn Header="Sıra" Binding="{Binding QueuePosition}" Width="70" /><DataGridTextColumn Header="Üye no" Binding="{Binding MemberNumber}" Width="120" /><DataGridTextColumn Header="Üye" Binding="{Binding MemberName}" Width="*" /><DataGridTextColumn Header="Kitap" Binding="{Binding BookTitle}" Width="1.4*" /><DataGridTextColumn Header="Tarih" Binding="{Binding RequestedAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150" /><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="100" /></DataGrid.Columns></DataGrid></StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Gecikenler}"><TextBlock Style="{StaticResource PageTitle}" Text="Gecikenler" /><DataGrid ItemsSource="{Binding OverdueLoans}" SelectedItem="{Binding SelectedLoan}" Height="520"><DataGrid.Columns><DataGridTextColumn Header="Üye no" Binding="{Binding MemberNumber}" Width="120" /><DataGridTextColumn Header="Üye" Binding="{Binding MemberName}" Width="*" /><DataGridTextColumn Header="Kitap" Binding="{Binding BookTitle}" Width="1.3*" /><DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="120" /><DataGridTextColumn Header="Teslim" Binding="{Binding DueAtUtc, StringFormat={}{0:dd.MM.yyyy}}" Width="110" /></DataGrid.Columns></DataGrid></StackPanel>
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource PageEquals}, ConverterParameter=Admin}">
                        <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Click="LockAdmin_Click" Content="Oturumu kilitle" /><TextBlock Style="{StaticResource PageTitle}" Text="Yönetim" /></DockPanel>
                        <TabControl Background="Transparent" BorderBrush="{StaticResource Rule}">
                            <TabItem Header="Kitap yönetimi"><Border Style="{StaticResource Panel}" Margin="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Label}" Text="Kitap adı" /><TextBox Text="{Binding NewBookTitle}" /><TextBlock Style="{StaticResource Label}" Text="Yazarlar" Margin="0,12,0,5" /><TextBox Text="{Binding NewBookAuthors}" /><TextBlock Style="{StaticResource Label}" Text="ISBN" Margin="0,12,0,5" /><TextBox Text="{Binding NewBookIsbn}" /><Button Command="{Binding LoadSelectedBookCommand}" Content="Katalogdaki seçimi yükle" Margin="0,16,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Kategori" /><TextBox Text="{Binding NewBookCategory}" /><TextBlock Style="{StaticResource Label}" Text="Barkod / demirbaş" Margin="0,12,0,5" /><TextBox Text="{Binding NewBookBarcode}" /><TextBlock Style="{StaticResource Label}" Text="Raf" Margin="0,12,0,5" /><TextBox Text="{Binding NewBookShelf}" /><Button Style="{StaticResource PrimaryButton}" Command="{Binding AddBookCommand}" Content="Yeni kitap ve kopya ekle" HorizontalAlignment="Right" Margin="0,16,0,0" /><UniformGrid Columns="3" Margin="0,12,0,0"><Button Command="{Binding UpdateSelectedBookCommand}" Content="Güncelle" Margin="0,0,4,0" /><Button Command="{Binding ArchiveSelectedBookCommand}" Content="Arşivle" Margin="4,0" /><Button Command="{Binding DeleteSelectedBookCommand}" Content="Kalıcı sil" Margin="4,0,0,0" /></UniformGrid></StackPanel></Grid></Border></TabItem>
                            <TabItem Header="Üye yönetimi"><ScrollViewer><Border Style="{StaticResource Panel}" Margin="12"><StackPanel MaxWidth="620" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Label}" Text="Üye numarası" /><TextBox Text="{Binding NewMemberNumber}" /><TextBlock Style="{StaticResource Label}" Text="Ad soyad" Margin="0,12,0,5" /><TextBox Text="{Binding NewMemberName}" /><TextBlock Style="{StaticResource Label}" Text="Üye türü" Margin="0,12,0,5" /><TextBox Text="{Binding NewMemberType}" /><TextBlock Style="{StaticResource Label}" Text="Sınıf / birim" Margin="0,12,0,5" /><TextBox Text="{Binding NewMemberUnit}" /><ItemsControl ItemsSource="{Binding EditableMemberFields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,12,0,0"><DockPanel Margin="0,0,0,5"><TextBlock Style="{StaticResource Label}" Text="{Binding Label}" /><TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono" FontSize="11" Text="{Binding FieldType}" /></DockPanel><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><DockPanel Margin="0,16,0,0"><Button DockPanel.Dock="Left" Command="{Binding LoadSelectedMemberCommand}" Content="Üyelerdeki seçimi yükle" /><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddMemberCommand}" Content="Yeni üye ekle" /></DockPanel><UniformGrid Columns="3" Margin="0,12,0,0"><Button Command="{Binding UpdateSelectedMemberCommand}" Content="Güncelle" Margin="0,0,4,0" /><Button Command="{Binding ArchiveSelectedMemberCommand}" Content="Arşivle" Margin="4,0" /><Button Command="{Binding DeleteSelectedMemberCommand}" Content="Kalıcı sil" Margin="4,0,0,0" /></UniformGrid></StackPanel></Border></ScrollViewer></TabItem>
                            <TabItem Header="Kurallar"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Ödünç kuralı ekle" /><UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Kural adı" /><TextBox Text="{Binding NewRuleName}" /></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Üye türü (isteğe bağlı)" /><TextBox Text="{Binding NewRuleMemberType}" /></StackPanel></UniformGrid><TextBlock Style="{StaticResource Label}" Text="Kitap kategorisi (isteğe bağlı)" Margin="0,12,0,5" /><TextBox Text="{Binding NewRuleCategory}" /><UniformGrid Columns="3" Margin="0,12,0,0"><StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="Gün" /><TextBox Text="{Binding NewRuleDays}" /></StackPanel><StackPanel Margin="6,0"><TextBlock Style="{StaticResource Label}" Text="Kitap sınırı" /><TextBox Text="{Binding NewRuleMaxLoans}" /></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Uzatma" /><TextBox Text="{Binding NewRuleMaxRenewals}" /></StackPanel></UniformGrid><Button Style="{StaticResource PrimaryButton}" Command="{Binding AddRuleCommand}" Content="Kural ekle" HorizontalAlignment="Right" Margin="0,16,0,0" /></StackPanel></Border><DataGrid Grid.Column="2" ItemsSource="{Binding LoanRules}"><DataGrid.Columns><DataGridTextColumn Header="Kural" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Gün" Binding="{Binding LoanDays}" Width="55" /><DataGridTextColumn Header="Sınır" Binding="{Binding MaxActiveLoans}" Width="55" /></DataGrid.Columns></DataGrid></Grid></TabItem>
                            <TabItem Header="Görevliler ve alanlar"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Görevli ekle" /><TextBlock Style="{StaticResource Label}" Text="Görevli adı" /><TextBox Text="{Binding NewOperatorName}" /><TextBlock Style="{StaticResource Label}" Text="PIN (isteğe bağlı)" Margin="0,12,0,5" /><TextBox Text="{Binding NewOperatorPin}" /><Button Style="{StaticResource PrimaryButton}" Command="{Binding AddOperatorCommand}" Content="Görevli ekle" HorizontalAlignment="Right" Margin="0,16,0,0" /><DataGrid ItemsSource="{Binding Operators}" Height="150" Margin="0,16,0,0"><DataGrid.Columns><DataGridTextColumn Header="Görevli" Binding="{Binding Name}" Width="*" /><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="70" /></DataGrid.Columns></DataGrid></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Üye alanı ekle" /><TextBlock Style="{StaticResource Label}" Text="Alan adı" /><TextBox Text="{Binding NewFieldName}" /><TextBlock Style="{StaticResource Label}" Text="Alan türü" Margin="0,12,0,5" /><ComboBox SelectedIndex="{Binding NewFieldTypeIndex}"><ComboBoxItem Content="Metin" /><ComboBoxItem Content="Sayı" /><ComboBoxItem Content="Tarih" /><ComboBoxItem Content="Seçim" /><ComboBoxItem Content="Evet / hayır" /></ComboBox><CheckBox Content="Zorunlu" IsChecked="{Binding NewFieldRequired}" Margin="0,12,0,5" /><CheckBox Content="Hassas alan — şifrele" IsChecked="{Binding NewFieldSensitive}" /><TextBox Text="{Binding NewFieldChoices}" ToolTip="Seçim türünde seçenekleri virgülle ayırın" Margin="0,12,0,0" /><Button Style="{StaticResource PrimaryButton}" Command="{Binding AddMemberFieldCommand}" Content="Alan ekle" HorizontalAlignment="Right" Margin="0,16,0,0" /></StackPanel></Border></Grid></TabItem>
                            <TabItem Header="İşlem günlüğü"><DataGrid ItemsSource="{Binding AuditEntries}" Margin="12" Height="430"><DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding OccurredAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145" /><DataGridTextColumn Header="İşlem" Binding="{Binding Activity}" Width="140" /><DataGridTextColumn Header="Görevli" Binding="{Binding Actor}" Width="130" /><DataGridTextColumn Header="Kayıt" Binding="{Binding Entity}" Width="130" /><DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*" /></DataGrid.Columns></DataGrid></TabItem>
                            <TabItem Header="Raporlar"><ScrollViewer><Border Style="{StaticResource Panel}" Margin="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Excel dönem raporu" /><TextBlock Style="{StaticResource Label}" Text="Dönem" /><ComboBox SelectedIndex="{Binding ReportPeriodIndex}"><ComboBoxItem Content="Günlük" /><ComboBoxItem Content="Haftalık (Pazartesi–Pazar)" /><ComboBoxItem Content="Aylık" /><ComboBoxItem Content="Özel tarih aralığı" /></ComboBox><UniformGrid Columns="2" Margin="0,12,0,0"><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Başlangıç" /><DatePicker SelectedDate="{Binding ReportStart}" /></StackPanel><StackPanel Margin="10,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Bitiş" /><DatePicker SelectedDate="{Binding ReportEnd}" /></StackPanel></UniformGrid><TextBlock Style="{StaticResource Label}" Text="İşlemler sütunları" Margin="0,16,0,5" /><WrapPanel><CheckBox IsChecked="{Binding IncludeReportDate}" Content="Tarih" Margin="0,0,14,8" /><CheckBox IsChecked="{Binding IncludeReportActivity}" Content="İşlem" Margin="0,0,14,8" /><CheckBox IsChecked="{Binding IncludeReportOperator}" Content="Görevli" Margin="0,0,14,8" /><CheckBox IsChecked="{Binding IncludeReportEntity}" Content="Kayıt türü" Margin="0,0,14,8" /><CheckBox IsChecked="{Binding IncludeReportDescription}" Content="Açıklama" Margin="0,0,14,8" /></WrapPanel><CheckBox IsChecked="{Binding IncludeOverdueSheet}" Content="Gecikenler sayfasını ekle" Margin="0,8,0,8" /><CheckBox IsChecked="{Binding IncludeReservationsSheet}" Content="Ayırtmalar sayfasını ekle" /><Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportReportCommand}" Content="Excel raporu oluştur" HorizontalAlignment="Right" Margin="0,20,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource SectionTitle}" Text="Rapor şablonları" /><TextBlock Style="{StaticResource Label}" Text="Şablon adı" /><TextBox Text="{Binding ReportPresetName}" /><ComboBox ItemsSource="{Binding ReportPresets}" SelectedItem="{Binding SelectedReportPreset}" DisplayMemberPath="Name" Margin="0,12,0,0" /><UniformGrid Columns="3" Margin="0,12,0,0"><Button Command="{Binding SaveReportPresetCommand}" Content="Kaydet" Margin="0,0,4,0" /><Button Command="{Binding ApplyReportPresetCommand}" Content="Uygula" Margin="4,0" /><Button Command="{Binding DeleteReportPresetCommand}" Content="Sil" Margin="4,0,0,0" /></UniformGrid></StackPanel></Grid></Border></ScrollViewer></TabItem>
                            <TabItem Header="Ayarlar"><ScrollViewer><Border Style="{StaticResource Panel}" Margin="12"><StackPanel MaxWidth="720" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SectionTitle}" Text="Kütüphane ayarları" /><UniformGrid Columns="2"><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Kütüphane adı" /><TextBox Text="{Binding SettingsLibraryName}" /></StackPanel><StackPanel Margin="10,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Logo dosyası (isteğe bağlı)" /><TextBox Text="{Binding SettingsLogoPath}" /></StackPanel></UniformGrid><UniformGrid Columns="2" Margin="0,14,0,0"><StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Label}" Text="Kütüphane türü" /><ComboBox SelectedIndex="{Binding SettingsLibraryTypeIndex}"><ComboBoxItem Content="Okul" /><ComboBoxItem Content="Halk" /><ComboBoxItem Content="Özel kurum" /><ComboBoxItem Content="Genel" /></ComboBox></StackPanel><StackPanel Margin="10,0,0,0"><TextBlock Style="{StaticResource Label}" Text="Görevli modu" /><ComboBox SelectedIndex="{Binding SettingsOperatorModeIndex}"><ComboBoxItem Content="Ortak görevli" /><ComboBoxItem Content="İsim seçimi" /><ComboBoxItem Content="PIN" /></ComboBox></StackPanel></UniformGrid><TextBlock Style="{StaticResource Label}" Text="Varsayılan ödünç sınırları" Margin="0,16,0,5" /><UniformGrid Columns="3"><StackPanel Margin="0,0,6,0"><TextBlock Foreground="{StaticResource Muted}" Text="Gün" /><TextBox Text="{Binding SettingsLoanDays}" /></StackPanel><StackPanel Margin="6,0"><TextBlock Foreground="{StaticResource Muted}" Text="Kitap" /><TextBox Text="{Binding SettingsMaxLoans}" /></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Foreground="{StaticResource Muted}" Text="Uzatma" /><TextBox Text="{Binding SettingsMaxRenewals}" /></StackPanel></UniformGrid><TextBlock Style="{StaticResource Label}" Text="Yedekleme klasörü" Margin="0,16,0,5" /><TextBox Text="{Binding SettingsBackupDirectory}" /><Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Content="Ayarları kaydet" HorizontalAlignment="Right" Margin="0,20,0,0" /></StackPanel></Border></ScrollViewer></TabItem>
                            <TabItem Header="Yedekleme"><Border Style="{StaticResource Panel}" Margin="12"><StackPanel MaxWidth="620" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SectionTitle}" Text="Şifreli yedek" /><TextBlock Foreground="{StaticResource Muted}" Text="Parola en az 10 karakter olmalıdır. Geri yüklemeden önce mevcut verinin güvenlik yedeği otomatik alınır." Margin="0,0,0,14" /><TextBlock Style="{StaticResource Label}" Text="Yedek parolası" /><PasswordBox x:Name="BackupPasswordBox" AutomationProperties.Name="Yedek parolası" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Click="RestoreBackup_Click" Content="Yedekten geri yükle" Margin="0,0,10,0" /><Button Style="{StaticResource PrimaryButton}" Click="CreateBackup_Click" Content="Yedek oluştur" /></StackPanel></StackPanel></Border></TabItem>
                        </TabControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="20,12"><TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Error}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
        </Grid>
    </Grid>
</Window>
