<Window x:Class="Qylent.Kutuphane.App.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qylent Kütüphane — İlk kurulum" Width="820" Height="650" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Grid Background="{DynamicResource Paper}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="28,22"><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontFamily="Cascadia Mono" Text="İLK KURULUM" /><StackPanel><TextBlock FontFamily="Bahnschrift SemiBold" FontWeight="SemiBold" FontSize="25" Text="Qylent Kütüphane" /><TextBlock Foreground="{DynamicResource Muted}" Text="Yerel veritabanını ve güvenlik ayarlarını hazırlayın." Margin="0,4,0,0" /></StackPanel></DockPanel></Border>
        <TabControl Grid.Row="1" x:Name="Steps" Margin="28,22" Background="Transparent" BorderBrush="{DynamicResource Rule}">
            <TabItem Header="1  Kurum"><ScrollViewer><StackPanel Margin="22" MaxWidth="610" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SectionTitle}" Text="Kurum profili" /><TextBlock Style="{StaticResource Label}" Text="Kütüphane adı" /><TextBox x:Name="LibraryName" Text="Qylent Kütüphane" /><TextBlock Style="{StaticResource Label}" Text="Kütüphane türü" Margin="0,14,0,5" /><ComboBox x:Name="LibraryType" SelectionChanged="LibraryType_SelectionChanged"><ComboBoxItem Content="Okul kütüphanesi" IsSelected="True" /><ComboBoxItem Content="Halk kütüphanesi" /><ComboBoxItem Content="Özel kurum" /><ComboBoxItem Content="Genel" /></ComboBox><Border Background="{DynamicResource Header}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,10,0,0"><TextBlock x:Name="ProfileDescription" Foreground="{DynamicResource Muted}" Text="Üyelerde Sınıf, Veli adı ve Veli telefonu kullanılır." /></Border><TextBlock Style="{StaticResource Label}" Text="Görevli çalışma yöntemi" Margin="0,14,0,5" /><ComboBox x:Name="OperatorMode"><ComboBoxItem Content="Ortak görevli" IsSelected="True" /><ComboBoxItem Content="İsim seçimi" /><ComboBoxItem Content="PIN ile giriş" /></ComboBox><TextBlock Style="{StaticResource Label}" Text="İlk görevli adı (isim seçimi / PIN için)" Margin="0,14,0,5" /><TextBox x:Name="InitialOperatorName" /><TextBlock Style="{StaticResource Label}" Text="İlk görevli PIN'i (PIN modu için)" Margin="0,14,0,5" /><PasswordBox x:Name="InitialOperatorPin" AutomationProperties.Name="İlk görevli PIN kodu" /><TextBlock Foreground="{DynamicResource Muted}" Margin="0,14,0,0" Text="Ortak görevli modunda ad ve PIN alanlarını boş bırakabilirsiniz." /></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="2  Kurallar"><StackPanel Margin="22" MaxWidth="610" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SectionTitle}" Text="Ödünç kuralları" /><TextBlock Style="{StaticResource Label}" Text="Varsayılan ödünç süresi (gün)" /><TextBox x:Name="LoanDays" Text="14" /><TextBlock Style="{StaticResource Label}" Text="Bir üyedeki en fazla kitap" Margin="0,14,0,5" /><TextBox x:Name="MaxLoans" Text="5" /><TextBlock Style="{StaticResource Label}" Text="En fazla uzatma" Margin="0,14,0,5" /><TextBox x:Name="MaxRenewals" Text="1" /><TextBlock Style="{StaticResource Label}" Text="Yedekleme klasörü" Margin="0,14,0,5" /><TextBox x:Name="BackupDirectory" /></StackPanel></TabItem>
            <TabItem Header="3  Güvenlik"><ScrollViewer><StackPanel Margin="22" MaxWidth="610" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SectionTitle}" Text="Yönetici güvenliği" /><TextBlock Style="{StaticResource Label}" Text="Yönetici şifresi" /><PasswordBox x:Name="AdminPassword" AutomationProperties.Name="Yönetici şifresi" /><TextBlock Style="{StaticResource Label}" Text="Şifreyi doğrulayın" Margin="0,14,0,5" /><PasswordBox x:Name="AdminPasswordAgain" AutomationProperties.Name="Yönetici şifresi doğrulama" /><TextBlock Style="{StaticResource Label}" Text="Güvenlik sorusu 1 — İlk okulunuz?" Margin="0,14,0,5" /><TextBox x:Name="Answer1" /><TextBlock Style="{StaticResource Label}" Text="Güvenlik sorusu 2 — En sevdiğiniz kitap?" Margin="0,14,0,5" /><TextBox x:Name="Answer2" /><TextBlock Style="{StaticResource Label}" Text="Güvenlik sorusu 3 — Doğduğunuz şehir?" Margin="0,14,0,5" /><TextBox x:Name="Answer3" /></StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="28,16"><DockPanel><TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" FontWeight="SemiBold" /><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="BackButton" Click="Back_Click" Content="Geri" IsEnabled="False" Margin="0,0,10,0" /><Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Click="Next_Click" Content="İleri" /></StackPanel></DockPanel></Border>
    </Grid>
</Window>
