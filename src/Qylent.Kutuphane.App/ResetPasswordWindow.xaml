<Window x:Class="Qylent.Kutuphane.App.ResetPasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yönetici şifresini sıfırla" Width="520" Height="590" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer><StackPanel><TextBlock Style="{StaticResource PageTitle}" FontSize="25" Text="Şifreyi sıfırla" /><TextBlock Foreground="{DynamicResource Muted}" Text="Kurulumda verdiğiniz üç cevabı girin. Büyük/küçük harf ve çevresel boşluklar dikkate alınmaz." Margin="0,0,0,16" /><TextBlock Style="{StaticResource Label}" Text="İlk okulunuz?" /><TextBox x:Name="Answer1" /><TextBlock Style="{StaticResource Label}" Text="En sevdiğiniz kitap?" Margin="0,12,0,5" /><TextBox x:Name="Answer2" /><TextBlock Style="{StaticResource Label}" Text="Doğduğunuz şehir?" Margin="0,12,0,5" /><TextBox x:Name="Answer3" /><TextBlock Style="{StaticResource Label}" Text="Yeni şifre" Margin="0,12,0,5" /><PasswordBox x:Name="NewPassword" /><TextBlock Style="{StaticResource Label}" Text="Yeni şifreyi doğrulayın" Margin="0,12,0,5" /><PasswordBox x:Name="NewPasswordAgain" /><TextBlock x:Name="ResultText" Foreground="{DynamicResource Error}" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button IsCancel="True" Content="Vazgeç" Margin="0,0,10,0" /><Button Style="{StaticResource PrimaryButton}" Click="Reset_Click" Content="Şifreyi değiştir" /></StackPanel>
    </Grid>
</Window>
