<!-- Hallmark · genre: modern-minimal · macrostructure: workbench · theme: cobalt · enrichment: none · nav: side-rail · footer: none · contrast: pass · slop: pass -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <Color x:Key="PaperColor">#F7F9FC</Color>
    <Color x:Key="SurfaceColor">#FCFDFF</Color>
    <Color x:Key="InkColor">#192235</Color>
    <Color x:Key="MutedColor">#566176</Color>
    <Color x:Key="RuleColor">#D9E0EC</Color>
    <Color x:Key="AccentColor">#2457D6</Color>
    <Color x:Key="AccentDarkColor">#173FAD</Color>
    <Color x:Key="AccentInkColor">#F9FBFF</Color>
    <Color x:Key="HoverColor">#EFF3FA</Color>
    <Color x:Key="PressedColor">#E5EBF6</Color>
    <Color x:Key="HeaderColor">#EEF2F8</Color>
    <Color x:Key="ErrorColor">#B42318</Color>
    <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Rule" Color="{StaticResource RuleColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="AccentDark" Color="{StaticResource AccentDarkColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="AccentInk" Color="{StaticResource AccentInkColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Pressed" Color="{StaticResource PressedColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Header" Color="{StaticResource HeaderColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}" options:Freeze="False" />
    <SolidColorBrush x:Key="Success" Color="#18794E" options:Freeze="False" />
    <SolidColorBrush x:Key="Focus" Color="#0B6EF3" options:Freeze="False" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource Paper}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold, Segoe UI Semibold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="Bahnschrift SemiBold, Segoe UI Semibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="44" /><Setter Property="Padding" Value="12,9" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Rule}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Focus}" /><Setter Property="BorderThickness" Value="2" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="44" /><Setter Property="Padding" Value="10,7" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Rule}" /></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Padding" Value="10,7" /><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Pressed}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger></Style.Triggers></Style>
    <Style TargetType="DatePicker"><Setter Property="Height" Value="44" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Rule}" /></Style>
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="96" /><Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rule}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" /><Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Pressed}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Focus}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentDark}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentDark}" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="MinWidth" Value="190" /><Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{DynamicResource Pressed}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Focus}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="14,10" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="Background" Value="Transparent" />
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Focus}" /><Setter Property="BorderThickness" Value="2" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Padding" Value="3" /><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Focus}" /><Setter Property="BorderThickness" Value="2" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger></Style.Triggers></Style>
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Rule}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="20" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="RowBackground" Value="{DynamicResource Surface}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource Header}" /><Setter Property="BorderBrush" Value="{DynamicResource Rule}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Rule}" /><Setter Property="RowHeight" Value="42" />
        <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="CanUserAddRows" Value="False" /><Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="False" />
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Header}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Height" Value="42" /><Setter Property="Padding" Value="10,0" /></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=RowBackground}" /><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource Header}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Pressed}" /></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8,0" /></Style>
</ResourceDictionary>
