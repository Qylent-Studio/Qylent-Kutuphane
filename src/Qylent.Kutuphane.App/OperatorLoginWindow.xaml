<Window x:Class="Qylent.Kutuphane.App.OperatorLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qylent Kütüphane — Görevli girişi" Width="460" MinHeight="440"
        SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Paper}">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Görevli girişi" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
            <TextBlock x:Name="ExplanationText" Text="İşlemlerin kimin tarafından yapıldığını kaydetmek için görevliyi seçin."
                       TextWrapping="Wrap" Margin="0,8,0,22" Foreground="{DynamicResource Muted}" />
            <TextBlock Text="Görevli" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="OperatorBox" DisplayMemberPath="Name" MinHeight="38" AutomationProperties.Name="Görevli" />
            <StackPanel x:Name="PinPanel" Margin="0,16,0,0">
                <TextBlock Text="PIN" FontWeight="SemiBold" Margin="0,0,0,6" />
                <PasswordBox x:Name="PinBox" MinHeight="38" AutomationProperties.Name="Görevli PIN kodu" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="Giriş yap"
                    Click="Login_Click" IsDefault="True" HorizontalAlignment="Right"
                    MinWidth="120" Padding="18,9" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</Window>
